{
  "name": "@todo/backend",
  "version": "0.0.1",
  "type": "module",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "bun build src/main.ts --outdir dist --target bun",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "bun --bun src/main.ts",
    "dev": "bun --watch src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "start:debug": "bun --inspect --watch src/main.ts",
    "start:prod": "bun --bun dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "bun test --preload ./src/test/setup.ts --env-file=../.env.test",
    "test:watch": "bun test --preload ./src/test/setup.ts --watch --env-file=../.env.test",
    "test:cov": "bun test --preload ./src/test/setup.ts --coverage --env-file=../.env.test"
  },
  "dependencies": {
    "@bogeychan/elysia-logger": "^0.1.10",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/cron": "^1.4.2",
    "@elysiajs/jwt": "^1.4.2",
    "@elysiajs/static": "^1.4.10",
    "@elysiajs/swagger": "^1.3.1",
    "@google/genai": "^1.52.0",
    "@noble/ciphers": "^2.4.0",
    "buffer-to-stream": "^1.0.0",
    "cloudinary": "^2.11.0",
    "croner": "6.0.7",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "elysia": "^1.4.30",
    "exceljs": "^4.4.0",
    "marked": "^17.0.6",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "reflect-metadata": "^0.2.2",
    "sanitize-html": "^2.18.0",
    "typeorm": "^0.3.31",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@elysiajs/eden": "^1.4.9",
    "@eslint/js": "^9.39.5",
    "@types/marked": "^6.0.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/sanitize-html": "^2.16.2",
    "bun-types": "^1.4.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "jose": "^6.2.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
